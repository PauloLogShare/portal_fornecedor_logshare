# Google Workspace OAuth 2.0 Client ID for LogShare SSO
# Create at: https://console.cloud.google.com/apis/credentials
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here
VITE_GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Official Google Apps Script Webhook URL for Google Drive & Google Sheets
VITE_GOOGLE_APPS_SCRIPT_WEBHOOK_URL=https://script.google.com/macros/s/your_script_id/exec

# Supabase Cloud Database Configuration
VITE_SUPABASE_URL=https://your_project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

